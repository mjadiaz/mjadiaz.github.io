---
import { fmtDate, isoDate, tagSlug, type Post } from '../lib/posts';

interface Props { post: Post }
const { post } = Astro.props;
const { title, description, date, tags, draft } = post.data;
---

<article>
  <a class="card" href={`/blog/${post.id}`}>
    <h3 class="post-item__title">
      {draft && <span class="tag" style="color:var(--warning);border-color:var(--warning);background:transparent">draft</span>}
      {title}
    </h3>
    <p class="post-item__excerpt">{description}</p>
    <div class="post-item__foot">
      <time class="meta" datetime={isoDate(date)}>{fmtDate(date)}</time>
      {tags.length > 0 && <span class="meta" aria-hidden="true">·</span>}
      {tags.map((t) => <span class="tag" data-tag={tagSlug(t)}>{t}</span>)}
    </div>
  </a>
</article>

---
/**
 * Video for posts. Either a file in /public (`src`) or a privacy-mode YouTube
 * embed (`youtube` = video id).
 *   <Video src="/videos/sim.mp4" poster="/videos/sim.jpg" caption="…" />
 *   <Video youtube="dQw4w9WgXcQ" caption="…" />
 */
interface Props {
  src?: string;
  youtube?: string;
  poster?: string;
  caption?: string;
  loop?: boolean;
}
const { src, youtube, poster, caption, loop = false } = Astro.props;
---

<figure>
  {src && (
    <video
      src={src}
      poster={poster}
      controls
      playsinline
      muted={loop}
      loop={loop}
      autoplay={loop}
      preload="metadata"
    ></video>
  )}
  {youtube && (
    <div class="ratio">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${youtube}`}
        title={caption ?? 'Video'}
        loading="lazy"
        allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  video {
    width: 100%;
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--panel);
  }
  .ratio {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--panel);
  }
  .ratio iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

---
import Base from '../layouts/Base.astro';
import { publications, ME } from '../data/publications';
import { site } from '../data/site';

const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
---

<Base title="Publications" description={`Publications by ${site.name}.`} bar={`${site.short} / publications`}>
  <p class="eyebrow">{publications.length} entries</p>
  <h1>Publications</h1>

  {years.map((year) => (
    <section class="section" style="margin-top:38px">
      <div class="section__head"><h2>{year}</h2></div>
      {publications.filter((p) => p.year === year).map((p) => (
        <div class="pub">
          <p class="pub__title">{p.title}</p>
          <p class="pub__authors">
            {p.authors.map((a, i) => (
              <>
                <span class={a === ME ? 'me' : undefined}>{a}</span>{i < p.authors.length - 1 ? ', ' : ''}
              </>
            ))}
          </p>
          <p class="pub__venue">
            {p.status && <span style="color:var(--accent);font-style:normal;font-weight:600">{p.status}</span>}
            {p.status ? ' · ' : ''}{p.venue}
          </p>
          {p.links && (
            <p class="pub__links">
              {p.links.map((l) => <a href={l.href}>{l.label}</a>)}
            </p>
          )}
        </div>
      ))}
    </section>
  ))}
</Base>
